{
  "name": "conflu-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "validate:education": "npx tsx scripts/validate-education.ts",
    "typegen:dump": "python -c \"import sys; sys.path.insert(0, '..'); from backend.app.api.main import app; import json; json.dump(app.openapi(), open('src/types/__generated__/openapi.json', 'w'), indent=2)\"",
    "typegen": "npm run typegen:dump && openapi-typescript src/types/__generated__/openapi.json -o src/types/__generated__/api.ts",
    "typegen:check": "npm run typegen && git diff --exit-code -- src/types/__generated__/"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-virtual": "^3.11.0",
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.14.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "8.20.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
