        "poolside/laguna-s-2.1:free": {
          "name": "OR-Poolside Laguna S 2.1 Free",
          "id": "openrouter/poolside/laguna-s-2.1:free",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 }
