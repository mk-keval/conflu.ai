  "lsp": true,
  "plugin": [
    "superpowers@latest",
    "oh-my-openagent@latest",
    "./plugins/lifecycle-hooks.js",
    "./plugins/claude-mem.js"
  ],
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "C:\\Users\\keval\\AppData\\Roaming\\npm\\gitnexus.cmd",
        "mcp"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--output-dir",
        ".playwright-output",
        "--output-mode",
        "file"
      ],
      "enabled": true
    },
    "mcp-sequentialthinking-tools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-sequentialthinking-tools"
      ],
      "enabled": true
