          "name": "OR-Nemotron Nano Omni Free",
          "id": "openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": { "context": 256000, "output": 65536 }
